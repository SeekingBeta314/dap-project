<?xml version="1.0"?>
<!--
  Dap hand: a rigid flat hand, a palm plus a finger plate fixed in the palm
  plane (like a flat human hand with straight fingers). No moving parts; the
  task is purely kinematic.

  Frame convention (the "hand" frame = the palm link frame, welded to
  iiwa_link_7 by scene.py):
    +z  palm normal, pointing away from the arm (the face that meets the partner)
    +x  toward the fingers
    +y  across the palm

  The fingers make the hand asymmetric about the palm normal, so the
  "fingers opposite" part of the meeting (partner x = -our x) is well defined
  and visible to the camera. The finger plate (1 cm thick) sits inside the
  palm's thickness, 5 mm behind the palm face (z = 0.005..0.015, face at
  z = 0.02), so in a correct palm-to-palm meeting neither hand's fingers
  intersect the other hand.
-->
<sdf version="1.9">
  <model name="dap_hand">
    <link name="palm">
      <inertial>
        <pose>0 0 0.01 0 0 0</pose>
        <mass>0.3</mass>
        <inertia>
          <ixx>3.7e-4</ixx><iyy>2.6e-4</iyy><izz>6.1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="palm_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>0.10 0.12 0.02</size></box></geometry>
        <material><diffuse>0.85 0.7 0.55 1</diffuse></material>
      </visual>
      <collision name="palm_collision">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>0.10 0.12 0.02</size></box></geometry>
      </collision>
    </link>

    <link name="fingers">
      <pose relative_to="palm">0.05 0 0.01 0 0 0</pose>
      <inertial>
        <pose>0.04 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>1.2e-4</ixx><iyy>5.4e-5</iyy><izz>1.7e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="fingers_visual">
        <pose>0.04 0 0 0 0 0</pose>
        <geometry><box><size>0.08 0.12 0.01</size></box></geometry>
        <material><diffuse>0.6 0.45 0.35 1</diffuse></material>
      </visual>
      <collision name="fingers_collision">
        <pose>0.04 0 0 0 0 0</pose>
        <geometry><box><size>0.08 0.12 0.01</size></box></geometry>
      </collision>
    </link>

    <joint name="fingers_weld" type="fixed">
      <parent>palm</parent>
      <child>fingers</child>
    </joint>
  </model>
</sdf>
